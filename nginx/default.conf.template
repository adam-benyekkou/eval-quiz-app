# Configuration rendue par envsubst au démarrage du conteneur
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*.conf).
# BACKEND_HOST et BACKEND_PORT sont fournis par l'environnement (Compose, Azure en J4).
# Le nom de l'upstream est résolu au démarrage : le backend doit être joignable en DNS
# à ce moment-là, sinon Nginx refuse de démarrer.

upstream backend {
    least_conn;
    server ${BACKEND_HOST}:${BACKEND_PORT};
}

server {
    # Port non privilégié : l'image tourne en utilisateur non-root
    listen 8080;
    server_name localhost;

    root /usr/share/nginx/html;

    # Main app
    location / {
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Admin page - serve gestion-quiz.html for /gestion-quiz route
    location = /gestion-quiz {
        try_files /gestion-quiz.html =404;
    }

    # API proxy to backend with load balancing
    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Health check endpoint
    location /health {
        proxy_pass http://backend;
        proxy_http_version 1.1;
    }
}
