# Paramètres publics (non sensibles)
POSTGRES_USER=quiz_user
POSTGRES_DB=quiz_db
FROM_EMAIL=Quiz App <noreply@votredomaine.com>
PORT=3007

# Secrets — valeurs fictives : copier ce fichier en .env et remplacer localement.
# `.env` est ignoré par git et ne doit jamais être commité.
POSTGRES_PASSWORD=quiz_password
# Obligatoire au démarrage du backend, même factice : Resend lève une erreur si la clé est vide.
RESEND_API_KEY=re_xxxxxxxxxxxx
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=change-this-to-a-secure-random-string

# DATABASE_URL n'est pas demandée ici : docker-compose.yml la construit
#   postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# et le port hôte publié par le frontend devient 8087 (http://localhost:8087).
